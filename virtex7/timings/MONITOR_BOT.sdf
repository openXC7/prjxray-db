
(DELAYFILE
    (SDFVERSION "3.0")
    (TIMESCALE 1ns)

    (CELL
        (CELLTYPE "XADC")
        (INSTANCE XADC)
        (DELAY
            (ABSOLUTE
                (IOPATH DCLK ALM (0.289::0.307)(0.755::0.801))
                (IOPATH DCLK BUSY (0.301::0.319)(0.763::0.809))
                (IOPATH DCLK CHANNEL (0.281::0.299)(0.749::0.795))
                (IOPATH DCLK DO (0.256::0.272)(0.704::0.748))
                (IOPATH DCLK DRDY (0.256::0.272)(0.699::0.741))
                (IOPATH DCLK EOC (0.379::0.403)(1.024::1.087))
                (IOPATH DCLK EOS (0.288::0.306)(0.768::0.816))
                (IOPATH DCLK JTAGBUSY (0.334::0.354)(0.843::0.895))
                (IOPATH DCLK JTAGLOCKED (0.276::0.294)(0.742::0.788))
                (IOPATH DCLK JTAGMODIFIED (0.273::0.289)(0.733::0.777))
                (IOPATH DCLK MUXADDR (0.355::0.377)(0.896::0.952))
                (IOPATH DCLK OT (0.301::0.319)(0.796::0.844))
            )
        )
        (TIMINGCHECK
            (HOLD DADDR (posedge DCLK) (-0.017::-0.003))
            (SETUP DADDR (posedge DCLK) (0.513::0.546))
            (HOLD DEN (posedge DCLK) (-0.031::-0.021))
            (SETUP DEN (posedge DCLK) (0.606::0.644))
            (HOLD DI (posedge DCLK) (-0.021::-0.007))
            (SETUP DI (posedge DCLK) (0.421::0.447))
            (HOLD DWE (posedge DCLK) (-0.037::-0.023))
            (SETUP DWE (posedge DCLK) (0.368::0.392))
        )
    )
)